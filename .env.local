NODE_ENV=development
APP_NAME=stocks-scalper-platform

DATABASE_URL=postgresql://stockradar:stockradar@localhost:55432/stockradar
REDIS_URL=redis://localhost:56379

POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=4210
WEB_PORT=3210
GATEWAY_PORT=4211
MT5_ADAPTER_PORT=4310

# MT5 Bridge — Python FastAPI server running on your Windows machine
# Connects Docker containers to your live MT5 terminal.
# Run integrations/mt5-bridge/run.ps1 FIRST, then start Docker.
MT5_BRIDGE_URL=http://host.docker.internal:8000

# ─── Market Data Provider ──────────────────────────────────────────────────────
# yahoo_finance = FREE, no API key needed. Uses Yahoo Finance public API.
# polygon = Requires POLYGON_API_KEY. Better real-time data (free tier: 5 req/min).
# alpha_vantage = Requires ALPHA_VANTAGE_API_KEY. Limited to 5 req/min on free tier.
MARKET_DATA_PROVIDER=yahoo_finance

# ─── News Provider ─────────────────────────────────────────────────────────────
# finnhub = RECOMMENDED. Free tier: 60 req/min. Get key: https://finnhub.io/register
# alpha_vantage = Slower, limited. Keep as fallback.
# polygon = Requires paid Polygon plan for news.
NEWS_PROVIDER=finnhub

# ─── API Keys ──────────────────────────────────────────────────────────────────
