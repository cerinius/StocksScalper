TRADINGVIEW_WEBHOOK_SECRET=local-tv-secret

# ─── Watchlist ─────────────────────────────────────────────────────────────────
# SMALL ACCOUNT ($1k) STRATEGY:
#
# Priority 1 — Crypto (BTCUSD, ETHUSD, SOLUSD):
#   ✅ No PDT rule (US Pattern Day Trader restriction doesn't apply)
#   ✅ Trades 24/7 — signals can trigger at any time
#   ✅ High liquidity, tight spreads on major pairs
#   ✅ Highly volatile — more movement = more opportunities
#
# Priority 2 — Forex (EURUSD, GBPUSD):
#   ✅ No PDT rule
#   ✅ Trades 23 hours/day (Sun 5pm – Fri 5pm ET)
#   ✅ Lowest spreads of any instrument
#   ✅ Very liquid, predictable momentum patterns
#
# Priority 3 — Gold (XAUUSD):
#   ✅ No PDT rule (commodity)
#   ✅ Strong intraday trends, responds well to news
#
# US Stocks (AAPL, NVDA, etc.):
#   ⚠️  PDT RULE: Under $25k in a US margin account, you're limited to
#       3 day trades per 5 business days. Either use a cash account
#       (Alpaca, Webull support this) or focus on crypto/forex until
#       the account grows past $25k.
WATCHLIST_FALLBACK_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,EURUSD,GBPUSD,XAUUSD,AAPL,NVDA,AMD,SPY
WATCHLIST_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,EURUSD,GBPUSD,XAUUSD,AAPL,NVDA,AMD,SPY

# Timeframes optimised for a compounding small account.
# 15m: catches most intraday setups with low noise
# 1h: higher-quality swing entries (better R/R)
# 1d: swing trades (hold overnight, bigger moves, fewer signals)
WATCHLIST_TIMEFRAMES=15m,1h,1d

# ─── Worker Schedules ──────────────────────────────────────────────────────────
# News: check every 60s for urgent, 300s for broad sweep.
NEWS_URGENT_INTERVAL_MS=60000
NEWS_BROAD_INTERVAL_MS=300000
NEWS_LIMIT=50

# Market scan: 45s — fast enough to catch breakouts, slow enough to avoid overloading.
# With 14 symbols × 4 timeframes = 56 calls per scan at 200ms each = ~11s.
MARKET_SCAN_INTERVAL_MS=45000

# Validation: 90s — gives time for analogs to be scored before execution.
VALIDATION_INTERVAL_MS=90000

# Execution: 10s — tight loop to catch fills and manage positions.
EXECUTION_INTERVAL_MS=10000

# Supervisor: 20s health check + daily summary.
SUPERVISOR_INTERVAL_MS=20000
DAILY_SUMMARY_CRON=55 23 * * *
MT5_SYNC_INTERVAL_MS=30000

SEND_LATEST_ON_STARTUP=true

# ─── Trading Mode ──────────────────────────────────────────────────────────────
# paper = System routes through MT5 Bridge but does NOT place real orders.
#         Uses your $100k OxSecurities Demo account for realistic simulation.
# live  = REAL orders will be placed on your MT5 account. Only switch when
#         you have confirmed consistent paper trading results for 2+ weeks.
TRADING_MODE=paper
MANUAL_APPROVAL_MODE=false
KILL_SWITCH=false

# ─── Risk Parameters — $100,000 Demo Account ──────────────────────────────────
#
# Daily gain target: 1% = $1,000/day on $100k
# Max single trade risk: 1% = $1,000 per trade (very manageable)
# Daily loss hard stop: 2.5% = $2,500 → system halts for the day
#
# With 2:1 R/R and 55% win rate: expectancy ~0.65R per trade
# Need only ~2-3 winning trades/day to hit 1% daily target
#
MAX_ACTIVE_TRADES=5
MAX_DAILY_LOSS_PCT=2.5
MAX_RISK_PER_TRADE_PCT=1.0
MAX_TOTAL_EXPOSURE_PCT=25
MAX_SYMBOL_EXPOSURE_PCT=10
MAX_CORRELATED_EXPOSURE_PCT=15

# Crypto/forex spreads can be wider — set tolerance accordingly
MAX_ENTRY_SPREAD_PCT=0.10

# Correlation blocking (crypto pairs tend to move together)
CORRELATION_BLOCK_THRESHOLD=0.80
CORRELATION_LOOKBACK_BARS=40

# Monte Carlo: 3000 simulations for accurate risk-of-ruin estimates
MONTE_CARLO_SIMULATIONS=3000
MONTE_CARLO_RUIN_DRAWDOWN_PCT=20

# Reduce position size when performance lags
MIN_DYNAMIC_RISK_PER_TRADE_PCT=0.25
RISK_THROTTLE_STEP_PCT=0.15
RISK_THROTTLE_COOLDOWN_MINUTES=60

# After 2 consecutive losses: pause 45 min (prevents compounding losses in bad sessions)
COOLDOWN_AFTER_LOSSES=2
COOLDOWN_MINUTES=45

# Signals older than 5 minutes discarded (especially on faster 15m timeframe)
STALE_SIGNAL_SECONDS=300

# ─── Admin ─────────────────────────────────────────────────────────────────────
LOCAL_ADMIN_EMAIL=admin@stockradar.local
LOCAL_ADMIN_NAME=Local Admin

