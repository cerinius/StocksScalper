FINNHUB_API_KEY=d7ba469r01qgc9t6kl9gd7ba469r01qgc9t6kla0

# Alpha Vantage: free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=ZVF5G43DRLZNJSG8

# Polygon.io: available as paid plan, keep for fallback market data
POLYGON_API_KEY=y6DoeLQqSaoJIUlc48t5eQv4phPG3C2n
MASSIVE_API_KEY=y6DoeLQqSaoJIUlc48t5eQv4phPG3C2n

# ─── Service URLs ──────────────────────────────────────────────────────────────
