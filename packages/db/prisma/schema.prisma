generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetClass {
  EQUITY
  ETF
  FX
  COMMODITY
  INDEX
  CRYPTO
}

enum UserRoleKey {
  ADMIN
  OPERATOR
  VIEWER
  RISK_MANAGER
  TRADER
}

enum IntegrationKind {
  DISCORD
  TRADINGVIEW
  MT5
  MARKET_DATA
  NEWS_DATA
}

enum IntegrationStatusType {
  CONNECTED
  DISCONNECTED
  DEGRADED
  ERROR
  PENDING
}

enum WorkerType {
  NEWS
  MARKET
  VALIDATION
  EXECUTION
  SUPERVISOR
}

enum WorkerRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum NewsDirection {
  BULLISH
  BEARISH
  NEUTRAL
}

enum NewsUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VolatilityImpact {
  LOW
  MEDIUM
  HIGH
}

enum CandidateStatus {
  NEW
  SCANNED
  VALIDATING
  VALIDATED
  REJECTED
  EXECUTED
  CLOSED
  INVALIDATED
}

enum ValidationStatus {
  PENDING
  PASSED
  FAILED
  STALE
}

enum ExecutionAction {
  PLACE
  HOLD
  SKIP
  CLOSE
  REDUCE
  INVALIDATE
}

enum ExecutionDecisionStatus {
  PROPOSED
  APPROVED
  SENT
  APPLIED
  REJECTED
  SIMULATED
}

enum TradingMode {
  PAPER
  LIVE
}

enum OrderStatus {
  PENDING
  SUBMITTED
  FILLED
  REJECTED
  CANCELED
}

enum PositionStatus {
  OPEN
  REDUCED
  CLOSED
}

enum RiskState {
  NORMAL
  CAUTION
  BLOCKED
  KILL_SWITCH
}

enum NotificationChannel {
  DISCORD
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum WebhookKind {
  TRADINGVIEW
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  REJECTED
  DUPLICATE
}

enum ActorType {
  SYSTEM
  USER
  WORKER
  WEBHOOK
}

enum AccountKind {
  PROP
  PERSONAL
  DEMO
}

enum AccountPhaseKind {
  EVALUATION
  VERIFICATION
  FUNDED
  PAYOUT_PROTECT
  SCALE_UP
  BREACHED
  PASSED
  PERSONAL
}

enum AccountPhaseOutcome {
  IN_PROGRESS
  PASSED
  FAILED
  WITHDRAWN
}

enum AccountMode {
  NORMAL
  CAUTIOUS
  RECOVERY
  TARGET_NEAR
  PAYOUT_PROTECT
  LOCKED
}

enum AccountHealth {
  HEALTHY
  WARNING
  CRITICAL
  BREACHED
}

enum AllocationPolicy {
  ONE_ACCOUNT_ONLY
  MAX_N_ACCOUNTS
  ALL_ELIGIBLE
  CHALLENGE_ONLY
  FUNDED_ONLY
  STRATEGY_TAGGED
}

enum AllocationStatus {
  PENDING
  ALLOCATED
  SKIPPED
  PARTIAL
  FAILED
}

enum SupervisionAction {
  HOLD
  TIGHTEN_STOP
  MOVE_TO_BREAKEVEN
  SCALE_OUT
  CLOSE
  FORCE_CLOSE_BREACH
  BLOCK_NEW_TRADES
  LOCK_ACCOUNT
  ENABLE_CAUTIOUS
  ENABLE_RECOVERY
  ENABLE_PAYOUT_PROTECT
}

enum SupervisionActionOrigin {
  DETERMINISTIC
  AI_SUGGESTED
  MANUAL
}

enum AiReviewKind {
  PRE_TRADE_CRITIC
  POSITION_SUPERVISOR
  POST_TRADE_JOURNAL
  WEEKLY_REVIEW
  NATURAL_LANGUAGE_QUERY
  NEWS_REVIEW
  RULE_DRIFT_REVIEW
  SETUP_QUALITY_REVIEW
}

enum AiVerdict {
  APPROVE
  APPROVE_WITH_CAUTION
  SUGGEST_REDUCE_SIZE
  SUGGEST_TIGHTEN_STOP
  SUGGEST_SCALE_OUT
  SUGGEST_CLOSE
  NEUTRAL
  CONCERNED
  OBJECT
  NO_ACTION
}

enum RuleViolationOutcome {
  BLOCKED
  REDUCED
  WARNED
  RECORDED
  FORCED_CLOSE
}

enum JournalExportStatus {
  PENDING
  WRITTEN
  STALE
  FAILED
  SUPERSEDED
}

enum JournalNoteKind {
  DAILY_SUMMARY
  WEEKLY_REVIEW
  SETUP_CARD
  TRADE_NOTE
  RULE_VIOLATION
  AI_LESSON
  ACCOUNT_OVERVIEW
  NEWS_BRIEF
  RUNBOOK
}

enum BridgeHealthStatus {
  CONNECTED
  DEGRADED
  STALE
  DISCONNECTED
  ERROR
}

enum AiLessonSource {
  POST_TRADE
  WEEKLY
  MANUAL
  BACKTEST
}

enum PortfolioBucketKind {
  SYMBOL
  CORRELATION_GROUP
  ASSET_CLASS
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles UserRole[]
}

model Role {
  id          String      @id @default(cuid())
  key         UserRoleKey @unique
  label       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Symbol {
  id               String         @id @default(cuid())
  ticker           String         @unique
  name             String?
  assetClass       AssetClass
  sector           String?
  exchange         String?
  isActive         Boolean        @default(true)
  correlationGroup String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  newsLinks        SymbolNewsLink[]
  marketSnapshots  MarketSnapshot[]
  priceBars        PriceBar[]
  tradeCandidates  TradeCandidate[]
  orders           Order[]
  positions        Position[]
  watchlistItems   WatchlistItem[]
  auditLogs        AuditLog[]

  @@index([assetClass, isActive])
  @@index([sector])
}

model Integration {
  id         String          @id @default(cuid())
  kind       IntegrationKind
  name       String
  mode       TradingMode?
  enabled    Boolean         @default(true)
  configJson Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  statuses          IntegrationStatus[]
  providerConfigs   ProviderConfig[]
  accountSnapshots  AccountSnapshot[]
  orders            Order[]
  accounts          Account[]
  bridgeSnapshots   BridgeHealthSnapshot[]
}

model IntegrationStatus {
  id              String                @id @default(cuid())
  integrationId   String
  status          IntegrationStatusType
  summary         String
  details         Json?
  lastHeartbeatAt DateTime?
  lastSyncAt      DateTime?
  failureCount    Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, status])
}

model ProviderConfig {
  id            String          @id @default(cuid())
  integrationId String?
  kind          IntegrationKind
  name          String
  isDefault     Boolean         @default(false)
  enabled       Boolean         @default(true)
  configJson    Json
  secretMask    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([kind, enabled])
}

model WorkerRun {
  id            String          @id @default(cuid())
  workerType    WorkerType
  status        WorkerRunStatus
  queueName     String
  jobName       String
  attempt       Int             @default(1)
  payload       Json?
  resultSummary String?
  reasoning     Json?
  correlationId String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  failures WorkerFailure[]

  @@index([workerType, status])
  @@index([startedAt])
}

model WorkerHeartbeat {
  id          String     @id @default(cuid())
  workerType  WorkerType @unique
  serviceName String
  status      String
  currentTask String?
  lagMs       Int        @default(0)
  metrics     Json?
  lastSeenAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model WorkerFailure {
  id           String     @id @default(cuid())
  workerRunId  String?
  workerType   WorkerType
  errorMessage String
  stack        String?
  payload      Json?
  retryCount   Int        @default(0)
  occurredAt   DateTime   @default(now())
  resolvedAt   DateTime?

  workerRun WorkerRun? @relation(fields: [workerRunId], references: [id], onDelete: SetNull)

  @@index([workerType, occurredAt])
}

model NotificationTemplate {
  id            String              @id @default(cuid())
  key           String              @unique
  channel       NotificationChannel
  severity      Severity
  titleTemplate String
  bodyTemplate  String
  enabled       Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  notifications Notification[]
}

model Notification {
  id            String              @id @default(cuid())
  templateId    String?
  category      String
  severity      Severity
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  dedupeKey     String
  title         String
  body          String
  payload       Json?
  retryCount    Int                 @default(0)
  lastAttemptAt DateTime?
  deliveredAt   DateTime?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  template         NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  supervisorEvents SupervisorEvent[]

  @@unique([dedupeKey])
  @@index([category, severity])
  @@index([status, createdAt])
}

model NewsItem {
  id                  String           @id @default(cuid())
  source              String
  headline            String
  summary             String
  originalTimestamp   DateTime
  ingestedAt          DateTime         @default(now())
  directionalBias     NewsDirection
  urgency             NewsUrgency
  relevanceScore      Float
  volatilityImpact    VolatilityImpact
  confidence          Float
  tags                Json
  category            String
  affectedAssetClass  Json
  rawPayloadRef       String
  reasoningLog        Json
  dedupeHash          String           @unique
  status              String
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  symbolLinks SymbolNewsLink[]

  @@index([urgency, originalTimestamp])
  @@index([source, category])
}

model SymbolNewsLink {
  id             String   @id @default(cuid())
  newsItemId     String
  symbolId       String
  relevanceScore Float
  reasoning      String?

  newsItem NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([newsItemId, symbolId])
  @@index([symbolId])
}

model Watchlist {
  id             String          @id @default(cuid())
  name           String
  description    String?
  tier           String
  scanIntervalMs Int
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items WatchlistItem[]
}

model WatchlistItem {
  id         String   @id @default(cuid())
  watchlistId String
  symbolId   String
  priority   Int      @default(50)
  notes      String?
  createdAt  DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbolId])
}

model PriceBar {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId, timeframe, timestamp])
}

model MarketSnapshot {
  id                String   @id @default(cuid())
  symbolId          String
  timeframe         String
  snapshotAt        DateTime
  currentPrice      Float
  ohlcv             Json
  indicatorSnapshot Json
  supportLevels     Json?
  resistanceLevels  Json?
  trendBias         String?
  volatilityRegime  String?
  sessionName       String?
  reasoningLog      Json
  rawSnapshotRef    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  symbol          Symbol           @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  tradeCandidates TradeCandidate[]

  @@index([symbolId, timeframe, snapshotAt])
}

model TradeCandidate {
  id                      String           @id @default(cuid())
  symbolId                String
  sourceWorkerType        WorkerType
  timeframe               String
  direction               String
  strategyType            String
  detectedAt              DateTime
  currentPrice            Float
  proposedEntry           Float
  stopLoss                Float
  takeProfit              Float
  riskReward              Float
  confidenceScore         Float
  setupScore              Float
  featureValues           Json
  indicatorSnapshot       Json
  marketSnapshotId        String?
  reasoningLog            Json
  status                  CandidateStatus  @default(NEW)
  correlationTags         Json
  volatilityClassification String
  newsContext             Json?
  dedupeHash              String?
  invalidatedAt           DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  symbol          Symbol            @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  marketSnapshot  MarketSnapshot?   @relation(fields: [marketSnapshotId], references: [id], onDelete: SetNull)
  validationRuns  ValidationRun[]
  decisions       ExecutionDecision[]
  riskEvents      RiskEvent[]
  incomingWebhooks IncomingWebhook[]
  allocations     AllocationDecision[]

  @@index([symbolId, status, detectedAt])
  @@index([sourceWorkerType, detectedAt])
}

model ValidationRun {
  id                        String           @id @default(cuid())
  candidateId               String
  status                    ValidationStatus @default(PENDING)
  finalValidationScore      Float
  winRateEstimate           Float
  averageReturn             Float
  averageAdverseExcursion   Float
  averageFavorableExcursion Float
  maxDrawdown               Float
  profitFactor              Float
  expectancy                Float
  confidenceScore           Float
  confidenceIntervalLow     Float
  confidenceIntervalHigh    Float
  sampleSize                Int
  dataQualityNotes          Json
  reasonsFor                Json
  reasonsAgainst            Json
  invalidationConditions    Json?
  backtestMetadata          Json
  createdAt                 DateTime         @default(now())
  completedAt               DateTime?
  updatedAt                 DateTime         @updatedAt

  candidate        TradeCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  backtestResults  BacktestResult[]
  decisions        ExecutionDecision[]

  @@index([candidateId, createdAt])
}

model BacktestResult {
  id                    String   @id @default(cuid())
  validationRunId       String
  scenarioLabel         String
  similarityScore       Float
  outcomeR              Float
  returnPct             Float
  maxAdverseExcursion   Float
  maxFavorableExcursion Float
  holdBars              Int
  occurredAt            DateTime
  context               Json

  validationRun ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Cascade)

  @@index([validationRunId, similarityScore])
}

model ExecutionDecision {
  id                   String                  @id @default(cuid())
  candidateId          String
  accountId            String?
  allocationDecisionId String?
  validationRunId      String?
  action               ExecutionAction
  confidence           Float
  riskScore            Float
  evidenceSummary      String
  reasons              Json
  blockingReasons      Json
  supportingReferences Json
  executionParameters  Json?
  structuredReasons    Json?
  preTradeAiReviewId   String?
  ruleEvaluations      Json?
  status               ExecutionDecisionStatus @default(PROPOSED)
  mode                 TradingMode
  idempotencyKey       String                  @unique
  createdAt            DateTime                @default(now())
  executedAt           DateTime?
  updatedAt            DateTime                @updatedAt

  candidate          TradeCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  account            Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  allocationDecision AllocationDecision?  @relation(fields: [allocationDecisionId], references: [id], onDelete: SetNull)
  validationRun      ValidationRun?       @relation(fields: [validationRunId], references: [id], onDelete: SetNull)
  preTradeAiReview   AiReview?            @relation("PreTradeCritic", fields: [preTradeAiReviewId], references: [id], onDelete: SetNull)
  orders             Order[]
  riskEvents         RiskEvent[]
  aiReviews          AiReview[]           @relation("DecisionAiReviews")
  ruleViolations     RuleViolation[]

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([allocationDecisionId])
}

model Order {
  id             String       @id @default(cuid())
  symbolId       String
  integrationId  String?
  accountId      String?
  decisionId     String?
  broker         String
  brokerOrderId  String?      @unique
  clientOrderId  String?      @unique
  mode           TradingMode
  direction      String
  orderType      String
  quantity       Float
  entryPrice     Float
  stopLoss       Float
  takeProfit     Float
  riskUsd        Float?
  status         OrderStatus
  submittedAt    DateTime?
  filledAt       DateTime?
  rejectedAt     DateTime?
  payload        Json?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  symbol      Symbol             @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  integration Integration?       @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  account     Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  decision    ExecutionDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  positions   Position[]

  @@index([symbolId, status])
  @@index([decisionId])
  @@index([accountId, status])
}

model Position {
  id               String         @id @default(cuid())
  symbolId         String
  accountId        String?
  orderId          String?
  brokerPositionId String?        @unique
  direction        String
  quantity         Float
  avgEntryPrice    Float
  stopLoss         Float
  takeProfit       Float
  unrealizedPnl    Float
  realizedPnl      Float
  exposurePct      Float
  riskUsdAtEntry   Float?
  currentRiskUsd   Float?
  status           PositionStatus
  openedAt         DateTime
  closedAt         DateTime?
  metadata         Json?
  lastSupervisedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  symbol             Symbol                      @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  order              Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  account            Account?                    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  riskEvents         RiskEvent[]
  supervisionTicks   PositionSupervisionTick[]
  aiReviews          AiReview[]                  @relation("PositionAiReviews")

  @@index([symbolId, status])
  @@index([accountId, status])
}

model AccountSnapshot {
  id                     String         @id @default(cuid())
  integrationId          String?
  accountId              String?
  accountPhaseId         String?
  capturedAt             DateTime       @default(now())
  balance                Float
  equity                 Float
  freeMargin             Float
  usedMargin             Float
  marginLevel            Float
  openPnl                Float
  realizedPnlDaily       Float
  drawdownPct            Float
  maxDrawdownPct         Float
  riskState              RiskState
  killSwitchActive       Boolean        @default(false)
  mode                   TradingMode
  accountMode            AccountMode?
  accountHealth          AccountHealth?
  phaseKind              AccountPhaseKind?
  dailyLossUsedUsd       Float?
  dailyLossUsedPct       Float?
  dailyLossRemainingUsd  Float?
  totalLossUsedUsd       Float?
  totalLossUsedPct       Float?
  totalLossRemainingUsd  Float?
  distanceToTargetUsd    Float?
  distanceToTargetPct    Float?
  consecutiveLosers      Int?
  openPositionCount      Int?
  concurrentRiskUsd      Float?
  concurrentRiskPct      Float?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  integration   Integration?   @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountPhase  AccountPhase?  @relation(fields: [accountPhaseId], references: [id], onDelete: SetNull)

  @@index([capturedAt])
  @@index([accountId, capturedAt])
}

model RiskEvent {
  id          String   @id @default(cuid())
  severity    Severity
  eventType   String
  message     String
  details     Json?
  blocking    Boolean  @default(false)
  candidateId String?
  decisionId  String?
  positionId  String?
  accountId   String?
  code        String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime @updatedAt

  candidate TradeCandidate?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  decision  ExecutionDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  position  Position?          @relation(fields: [positionId], references: [id], onDelete: SetNull)
  account   Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([severity, createdAt])
  @@index([accountId, createdAt])
}

model AuditLog {
  id            String     @id @default(cuid())
  actorType     ActorType
  actorId       String?
  workerType    WorkerType?
  severity      Severity
  category      String
  message       String
  entityType    String?
  entityId      String?
  symbolId      String?
  correlationId String?
  data          Json?
  createdAt     DateTime   @default(now())

  symbol Symbol? @relation(fields: [symbolId], references: [id], onDelete: SetNull)

  @@index([category, createdAt])
  @@index([symbolId, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  valueType   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupervisorEvent {
  id             String        @id @default(cuid())
  severity       Severity
  eventType      String
  summary        String
  details        Json?
  notificationId String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([severity, createdAt])
}

model IncomingWebhook {
  id                 String                  @id @default(cuid())
  kind               WebhookKind
  sourceIp           String?
  headers            Json?
  payload            Json
  signatureValid     Boolean                 @default(false)
  dedupeHash         String                  @unique
  processingStatus   WebhookProcessingStatus @default(PENDING)
  processedAt        DateTime?
  createdCandidateId String?
  auditLogId         String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  createdCandidate TradeCandidate? @relation(fields: [createdCandidateId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
}

// ============================================================================
// Multi-account / funded-trading domain
// ============================================================================

model Account {
  id                    String       @id @default(cuid())
  displayName           String       @unique
  kind                  AccountKind
  providerName          String
  brokerAccountLogin    String?
  integrationId         String
  currency              String       @default("USD")
  startingBalance       Float
  mode                  AccountMode  @default(NORMAL)
  health                AccountHealth @default(HEALTHY)
  isActive              Boolean      @default(true)
  currentPhaseId        String?      @unique
  activeRuleProfileId   String?      @unique
  tradingMode           TradingMode  @default(PAPER)
  tags                  Json         @default("[]")
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  integration         Integration              @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  currentPhase        AccountPhase?            @relation("CurrentAccountPhase", fields: [currentPhaseId], references: [id], onDelete: SetNull)
  activeRuleProfile   AccountRuleProfile?      @relation("ActiveAccountRuleProfile", fields: [activeRuleProfileId], references: [id], onDelete: SetNull)
  phases              AccountPhase[]           @relation("AccountPhases")
  ruleProfiles        AccountRuleProfile[]     @relation("AccountRuleProfiles")
  dailyMetrics        AccountDailyMetric[]
  snapshots           AccountSnapshot[]
  orders              Order[]
  positions           Position[]
  decisions           ExecutionDecision[]
  riskEvents          RiskEvent[]
  allocationCandidates AccountAllocationCandidate[]
  bridgeSnapshots     BridgeHealthSnapshot[]
  supervisionTicks    PositionSupervisionTick[]
  aiReviews           AiReview[]
  aiLessons           AiLesson[]
  weeklyReviews       WeeklyReview[]
  ruleViolations      RuleViolation[]
  portfolioBuckets    PortfolioBucketExposure[]

  @@index([kind, isActive])
  @@index([providerName])
}

model AccountPhase {
  id                   String                @id @default(cuid())
  accountId            String
  kind                 AccountPhaseKind
  isActive             Boolean               @default(true)
  startedAt            DateTime              @default(now())
  endedAt              DateTime?
  startingBalance      Float
  profitTargetUsd      Float?
  dailyLossLimitUsd    Float
  totalLossLimitUsd    Float
  outcome              AccountPhaseOutcome   @default(IN_PROGRESS)
  reason               String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  account          Account           @relation("AccountPhases", fields: [accountId], references: [id], onDelete: Cascade)
  currentForAccount Account?         @relation("CurrentAccountPhase")
  snapshots        AccountSnapshot[]

  @@index([accountId, isActive])
  @@index([kind, isActive])
}

model AccountRuleProfile {
  id                         String   @id @default(cuid())
  accountId                  String
  version                    Int      @default(1)
  isActive                   Boolean  @default(true)
  providerName               String
  providerRulesUrl           String?
  startingBalance            Float
  dailyLossLimitUsd          Float
  totalLossLimitUsd          Float
  trailingDrawdownUsd        Float?
  profitTargetUsd            Float?
  maxRiskPerTradePct         Float
  maxRiskPerTradeUsd         Float
  minRiskRewardRatio         Float    @default(1.5)
  maxOpenPositions           Int      @default(3)
  maxConcurrentRiskPct       Float    @default(0.03)
  maxCorrelatedPositions     Int      @default(2)
  allowedAssetClasses        Json     @default("[]")
  forbiddenAssetClasses      Json     @default("[]")
  allowedSessions            Json     @default("[]")
  forbiddenSessions          Json     @default("[]")
  allowedTimeframes          Json     @default("[]")
  noTradeBeforeUtc           String?
  noTradeAfterUtc            String?
  newsBlackoutMinutesBefore  Int      @default(0)
  newsBlackoutMinutesAfter   Int      @default(0)
  newsBlackoutUrgencies      Json     @default("[]")
  blockWeekendHold           Boolean  @default(true)
  allowHedging               Boolean  @default(false)
  cautiousLossFraction       Float    @default(0.5)
  recoveryLossFraction       Float    @default(0.75)
  targetNearFraction         Float?
  payoutEligibleAfter        Int      @default(0)
  payoutProtectWindowDays    Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  account           Account  @relation("AccountRuleProfiles", fields: [accountId], references: [id], onDelete: Cascade)
  currentForAccount Account? @relation("ActiveAccountRuleProfile")

  @@unique([accountId, version])
  @@index([accountId, isActive])
}

model AccountDailyMetric {
  id                    String         @id @default(cuid())
  accountId             String
  date                  String         // YYYY-MM-DD
  startingBalance       Float
  startingEquity        Float
  endingBalance         Float
  endingEquity          Float
  highWaterMark         Float
  lowWaterMark          Float
  realizedPnl           Float
  unrealizedPnlClose    Float
  totalFees             Float
  tradesOpened          Int            @default(0)
  tradesClosed          Int            @default(0)
  winners               Int            @default(0)
  losers                Int            @default(0)
  dailyLossUsedPct      Float          @default(0)
  totalLossUsedPct      Float          @default(0)
  distanceToTargetPct   Float?
  rulesViolated         Json           @default("[]")
  modeEnded             AccountMode    @default(NORMAL)
  healthEnded           AccountHealth  @default(HEALTHY)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([date])
}

// ============================================================================
// Allocation
// ============================================================================

model AllocationDecision {
  id                   String            @id @default(cuid())
  candidateId          String
  policy               AllocationPolicy
  setupKey             String
  status               AllocationStatus  @default(PENDING)
  selectedAccountIds   Json              @default("[]")
  summary              String?
  idempotencyKey       String            @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  candidate   TradeCandidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidates  AccountAllocationCandidate[]
  decisions   ExecutionDecision[]

  @@index([candidateId, createdAt])
  @@index([status, createdAt])
}

model AccountAllocationCandidate {
  id                   String   @id @default(cuid())
  allocationDecisionId String
  accountId            String
  selected             Boolean  @default(false)
  totalScore           Float
  componentsJson       Json
  reasonCodes          Json     @default("[]")
  message              String
  proposedRiskUsd      Float?
  proposedQuantity     Float?
  proposedStopLoss     Float?
  proposedTakeProfit   Float?
  createdAt            DateTime @default(now())

  allocationDecision AllocationDecision @relation(fields: [allocationDecisionId], references: [id], onDelete: Cascade)
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([allocationDecisionId, accountId])
  @@index([accountId, createdAt])
}

model SetupAllocationPolicy {
  id                 String            @id @default(cuid())
  setupKey           String            @unique
  policy             AllocationPolicy
  maxAccounts        Int               @default(1)
  requiredTags       Json              @default("[]")
  excludedTags       Json              @default("[]")
  allowedPhaseKinds  Json              @default("[]")
  allowedAccountModes Json             @default("[]")
  preferHigherHealth Boolean           @default(true)
  preferLowerUtilization Boolean       @default(true)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// ============================================================================
// Portfolio exposure
// ============================================================================

model PortfolioBucketExposure {
  id                       String              @id @default(cuid())
  kind                     PortfolioBucketKind
  bucketKey                String
  accountId                String?
  asOf                     DateTime            @default(now())
  accountCount             Int                 @default(0)
  openPositionCount        Int                 @default(0)
  netQuantityLong          Float               @default(0)
  netQuantityShort         Float               @default(0)
  netDirection             String              @default("FLAT")
  grossRiskUsd             Float               @default(0)
  netRiskUsd               Float               @default(0)
  aggregateUnrealizedPnl   Float               @default(0)
  aggregateExposurePct     Float               @default(0)
  perAccountJson           Json                @default("[]")
  createdAt                DateTime            @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([kind, bucketKey, asOf])
  @@index([accountId, asOf])
}

// ============================================================================
// Bridge health
// ============================================================================

model BridgeHealthSnapshot {
  id                    String             @id @default(cuid())
  accountId             String
  integrationId         String
  bridgeHost            String
  capturedAt            DateTime           @default(now())
  status                BridgeHealthStatus
  terminalConnected     Boolean            @default(false)
  brokerConnected       Boolean            @default(false)
  accountLogin          String?
  server                String?
  pingMs                Int?
  lastOrderAckMs        Int?
  lastPositionSyncMs    Int?
  lastHeartbeatAt       DateTime
  stalenessSeconds      Int                @default(0)
  sdkVersion            String?
  notes                 String?

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
  @@index([status, capturedAt])
}

// ============================================================================
// Supervision
// ============================================================================

model PositionSupervisionTick {
  id                    String                  @id @default(cuid())
  positionId            String
  accountId             String
  asOf                  DateTime                @default(now())
  unrealizedPnlPct      Float
  adversePct            Float
  timeInTradeMinutes    Int
  invalidationTriggered Boolean                 @default(false)
  suggestedAction       SupervisionAction
  origin                SupervisionActionOrigin @default(DETERMINISTIC)
  reasonCodes           Json                    @default("[]")
  reasonSummary         String
  aiReviewId            String?
  aiAdvisoryVerdict     AiVerdict?
  aiAdvisoryReasoning   String?
  executed              Boolean                 @default(false)
  executedAt            DateTime?
  errorMessage          String?

  position Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  aiReview AiReview? @relation("SupervisionAiReviews", fields: [aiReviewId], references: [id], onDelete: SetNull)

  @@index([positionId, asOf])
  @@index([accountId, asOf])
  @@index([suggestedAction, asOf])
}

model RuleViolation {
  id              String                @id @default(cuid())
  accountId       String
  ruleCode        String
  severity        Severity
  outcome         RuleViolationOutcome
  message         String
  observedJson    Json?
  expectedJson    Json?
  candidateId     String?
  decisionId      String?
  positionId      String?
  createdAt       DateTime              @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime              @updatedAt

  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  decision  ExecutionDecision?  @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([ruleCode, createdAt])
}

// ============================================================================
// AI (advisory only)
// ============================================================================

model AiReview {
  id                     String        @id @default(cuid())
  kind                   AiReviewKind
  accountId              String?
  candidateId            String?
  decisionId             String?
  positionId             String?
  correlationId          String
  model                  String
  promptVersion          String
  promptTokens           Int           @default(0)
  responseTokens         Int           @default(0)
  latencyMs              Int           @default(0)
  contextDigest          String
  rawPromptRef           String?
  rawResponseRef         String?
  verdict                AiVerdict
  confidence             Float
  summary                String
  concerns               Json          @default("[]")
  suggestions            Json          @default("[]")
  structuredOutput       Json?
  safetyFiltered         Boolean       @default(false)
  safetyFilterReasons    Json          @default("[]")
  createdAt              DateTime      @default(now())

  account             Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  decision            ExecutionDecision? @relation("DecisionAiReviews", fields: [decisionId], references: [id], onDelete: SetNull)
  position            Position?         @relation("PositionAiReviews", fields: [positionId], references: [id], onDelete: SetNull)
  supervisionTicks    PositionSupervisionTick[] @relation("SupervisionAiReviews")
  preTradeFor         ExecutionDecision[]       @relation("PreTradeCritic")

  @@index([kind, createdAt])
  @@index([accountId, kind, createdAt])
  @@index([correlationId])
}

model AiLesson {
  id           String          @id @default(cuid())
  sourceKind   AiLessonSource
  sourceId     String?
  accountId    String?
  title        String
  detail       String
  tags         Json            @default("[]")
  weight       Float           @default(0.5)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([active, updatedAt])
  @@index([accountId, active])
}

model WeeklyReview {
  id               String   @id @default(cuid())
  accountId        String?
  weekStart        String
  weekEnd          String
  kpis             Json     @default("{}")
  output           Json
  aiReviewId       String?  @unique
  obsidianNoteRef  String?
  createdAt        DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([accountId, weekStart])
  @@index([weekStart])
}

// ============================================================================
// Journal exporter (Obsidian)
// ============================================================================

model JournalExport {
  id             String               @id @default(cuid())
  kind           JournalNoteKind
  entityId       String
  bucket         String
  accountId      String?
  relativePath   String
  contentHash    String
  status         JournalExportStatus  @default(PENDING)
  attempts       Int                  @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
  writtenAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([kind, entityId, bucket])
  @@index([status, updatedAt])
  @@index([accountId, updatedAt])
}
